<Window x:Class="Aurora.App.Views.LockdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora Security Lockdown"
        Width="520"
        Height="360"
        MinWidth="520"
        MinHeight="360"
        WindowStyle="SingleBorderWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        Background="#080B11"
        WindowStartupLocation="CenterOwner"
        ShowActivated="True">
    <Grid Background="#080B11">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="AURORA SECURITY LOCKDOWN" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Aurora is locked. Windows and other applications remain available."
                           Foreground="#D0D7E2" FontSize="13" Margin="0,8,0,0" TextAlignment="Center"/>
            </StackPanel>

            <Border Grid.Row="1" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#12161F" BorderBrush="#F0B65C" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Recovery" Foreground="#F0B65C" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RecoveryCodeDisplay" Foreground="#5BE0A0" FontSize="13" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Text="Enter a recovery code for the active Aurora profile."
                               Foreground="#D0D7E2" TextWrapping="Wrap" Margin="0,8,0,12"/>
                    <PasswordBox x:Name="RecoveryCodeBox" Height="38" FontSize="15" Padding="8"
                                 KeyDown="RecoveryCodeBox_KeyDown"/>
                    <TextBlock x:Name="StatusText" Foreground="#D0D7E2" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <Button Content="Verify and unlock" Click="Recover_Click" Height="38" Margin="0,12,0,0"
                            Background="#4B16A0" Foreground="White" BorderThickness="0" FontSize="14"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2" Text="Closing this Aurora window does not bypass lockdown."
                       Foreground="#D0D7E2" FontSize="11" HorizontalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>

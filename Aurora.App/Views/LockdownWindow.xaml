<Window x:Class="Aurora.App.Views.LockdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora Security Lockdown"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#080B11"
        WindowStartupLocation="Manual"
        ShowActivated="True">
    <Grid Background="#080B11">
        <Grid Margin="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="AURORA SECURITY LOCKDOWN" Foreground="#FFFFFF" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Aurora has stopped interactive access until the installation and user recovery checks pass."
                           Foreground="#D0D7E2" FontSize="15" Margin="0,10,0,0" TextAlignment="Center"/>
            </StackPanel>

            <Border Grid.Row="1" MaxWidth="620" MaxHeight="430" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#12161F" BorderBrush="#F0B65C" BorderThickness="1" CornerRadius="18" Padding="28">
                <StackPanel>
                    <TextBlock Text="Recovery" Foreground="#F0B65C" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="Enter one of the recovery codes generated for the active Aurora profile."
                               Foreground="#D0D7E2" TextWrapping="Wrap" Margin="0,10,0,18"/>
                    <PasswordBox x:Name="RecoveryCodeBox" Height="44" FontSize="16" Padding="10"
                                 KeyDown="RecoveryCodeBox_KeyDown"/>
                    <TextBlock x:Name="StatusText" Foreground="#D0D7E2" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    <Button Content="Verify and unlock" Click="Recover_Click" Height="44" Margin="0,18,0,0"
                            Background="#4B16A0" Foreground="White" BorderThickness="0" FontSize="15"/>
                    <TextBlock Text="If the installation signature cannot be verified, Aurora remains locked."
                               Foreground="#D0D7E2" FontSize="11" TextWrapping="Wrap" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2" Text="Emergency stop is fail-closed. Closing this screen does not bypass lockdown."
                       Foreground="#D0D7E2" FontSize="12" HorizontalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>

<Window x:Class="Aurora.App.Views.RecoveryCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora Recovery Code" Width="680" MinWidth="620" MinHeight="470"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgDeepBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Profile recovery" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="ProfileLabel" Foreground="{DynamicResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="Create a recovery code for this profile. Aurora stores only a secure verifier; the code itself is shown to you once."
                       Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,24,0,20" Padding="24" Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource IdleGlowBrush}" BorderThickness="1" CornerRadius="14">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Your recovery code" HorizontalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBox x:Name="RecoveryCodeBox" Margin="0,12,0,18" Padding="12" FontSize="22" FontFamily="Consolas"
                         FontWeight="SemiBold" TextAlignment="Center" IsReadOnly="True" Background="{DynamicResource BgDeepBrush}"
                         Foreground="{DynamicResource AccentGreenBrush}" BorderBrush="{DynamicResource IdleGlowBrush}" BorderThickness="1"/>
                <WrapPanel HorizontalAlignment="Center">
                    <Button Content="Generate" Click="Generate_Click" Padding="18,10,18,10" Margin="4"/>
                    <Button x:Name="CopyButton" Content="Copy" Click="Copy_Click" Padding="18,10,18,10" Margin="4" IsEnabled="False"/>
                    <Button x:Name="SaveButton" Content="Save to file" Click="Save_Click" Padding="18,10,18,10" Margin="4" IsEnabled="False"/>
                    <Button x:Name="PrintButton" Content="Print" Click="Print_Click" Padding="18,10,18,10" Margin="4" IsEnabled="False"/>
                </WrapPanel>
                <TextBlock Text="Save or print this code before confirming. Do not put it in GitHub, logs, screenshots, or connector messages."
                           Foreground="{DynamicResource AccentAmberBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="12,18,12,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2">
            <CheckBox x:Name="SavedCheckBox" Foreground="{DynamicResource TextPrimaryBrush}" Checked="SavedCheckBox_Checked">
                <TextBlock Text="I have saved my recovery code somewhere safe." TextWrapping="Wrap"/>
            </CheckBox>
            <WrapPanel HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="Cancel" Click="Cancel_Click" Padding="18,9,18,9" Margin="0,0,8,0"/>
                <Button x:Name="DoneButton" Content="Save recovery code" Click="Done_Click" Padding="18,9,18,9" IsEnabled="False"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</Window>

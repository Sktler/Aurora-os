<Window x:Class="Aurora.App.Views.MiniCompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="200" Height="200" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="True">
    <Grid Width="200" Height="200" Background="Transparent" MouseLeftButtonDown="Avatar_MouseLeftButtonDown">
        <Image x:Name="AuroraOrbImage" Tag="AuroraOrb" Source="/Aurora;component/Assets/AuroraOrb.png"
               Width="500" Height="500"
               Stretch="Uniform"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Visibility="Visible" Opacity="1"
               IsHitTestVisible="False"
               SnapsToDevicePixels="True"
               RenderOptions.BitmapScalingMode="HighQuality"/>
        <Button Content="×" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" Click="Close_Click" Background="#101821" Foreground="White" BorderBrush="#4FD8E8" BorderThickness="1" Padding="0" FontSize="15" Panel.ZIndex="2"/>
    </Grid>
</Window>

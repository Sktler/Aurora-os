<Window x:Class="Aurora.App.Views.ProfileWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Aurora.App.Views" Title="Aurora Profiles" Width="920" Height="620" MinWidth="720" MinHeight="500" WindowStartupLocation="CenterOwner" Background="{DynamicResource BgDeepBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="User profiles" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Each profile has separate settings and companion memory. Voice matching is optional and only suggests a profile." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,16"/></StackPanel>
        <ListBox x:Name="ProfilesList" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource IdleGlowBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="6">
            <ListBox.ItemTemplate><DataTemplate><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,16,0"><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{local:LocBinding SpeakerEnrolled, Template='Voice enrolled: {0}'}" Foreground="{DynamicResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="Delete" Click="DeleteProfile_Click" Padding="10,5,10,5" Background="{DynamicResource BgCardBrush}" Foreground="#FF9AA2" BorderBrush="#7A2A33"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <WrapPanel>
                <Button Content="Add profile" Click="AddProfile_Click" Padding="16,9,16,9" Margin="0,0,8,0"/><Button Content="Refresh" Click="RefreshProfiles_Click" Padding="16,9,16,9" Margin="0,0,8,0"/><Button Content="Use selected" Click="UseSelected_Click" Padding="16,9,16,9" Margin="0,0,8,0"/><Button Content="Enroll voice" Click="EnrollVoice_Click" Padding="16,9,16,9" Margin="0,0,8,0"/><Button Content="🔐 Recovery code" Click="RecoveryCode_Click" Padding="16,9,16,9" Margin="0,0,8,0"/><Button Content="📁 Recovery storage" Click="RecoveryStorage_Click" Padding="16,9,16,9" Margin="0,0,8,0"/><Button Content="Open recovery folder" Click="OpenRecoveryFolder_Click" Padding="16,9,16,9"/>
                <CheckBox x:Name="SpeakerSuggestionsBox" Content=" Enable speaker suggestions" Margin="18,10,0,0" Foreground="{DynamicResource TextPrimaryBrush}"/>
            </WrapPanel>
            <TextBlock Text="Recovery storage: " Foreground="{DynamicResource TextMutedBrush}" Margin="0,10,0,0"/><TextBlock x:Name="RecoveryStoragePathText" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>

<UserControl x:Class="Aurora.App.Views.ParticleOrb"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ClipToBounds="False">
        <Grid x:Name="OrbContent"
              Margin="8"
              RenderTransformOrigin="0.5,0.5">
            <Grid.Effect>
                <DropShadowEffect Color="#4FD8E8"
                                  BlurRadius="28"
                                  ShadowDepth="0"
                                  Opacity="0.48"/>
            </Grid.Effect>
            <Grid.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="OrbNod"/>
                    <TranslateTransform x:Name="OrbTranslation"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Image Source="/Aurora;component/Assets/AuroraOrb.png"
                   Stretch="Uniform"
                   Opacity="0.96"/>
            <Viewbox Stretch="Uniform"
                     IsHitTestVisible="False">
                <Canvas Width="100" Height="100">
                    <Ellipse Width="9" Height="12" Canvas.Left="33" Canvas.Top="42" Fill="#D9F8FF">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="LeftEyeScale" CenterX="4.5" CenterY="6"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse Width="9" Height="12" Canvas.Left="58" Canvas.Top="42" Fill="#D9F8FF">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="RightEyeScale" CenterX="4.5" CenterY="6"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Border Width="22" Height="8" Canvas.Left="39" Canvas.Top="61" CornerRadius="0,0,11,11" Background="#D9F8FF">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="MouthScale" CenterX="11" CenterY="0"/>
                        </Border.RenderTransform>
                    </Border>
                </Canvas>
            </Viewbox>
        </Grid>
    </Grid>
</UserControl>

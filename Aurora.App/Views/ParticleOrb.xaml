<UserControl x:Class="Aurora.App.Views.ParticleOrb"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ClipToBounds="False">
        <Image x:Name="OrbImage"
               Source="/Aurora;component/Assets/AuroraOrb.png"
               Stretch="Uniform"
               Margin="8"
               RenderTransformOrigin="0.5,0.5"
               Opacity="0.96">
            <Image.Effect>
                <DropShadowEffect Color="#4FD8E8"
                                  BlurRadius="28"
                                  ShadowDepth="0"
                                  Opacity="0.48"/>
            </Image.Effect>
            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="OrbScale"/>
                    <RotateTransform x:Name="OrbRotation"/>
                    <TranslateTransform x:Name="OrbTranslation"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>
    </Grid>
</UserControl>

<UserControl x:Class="Aurora.App.Views.ParticleOrb"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid ClipToBounds="False">
        <Grid x:Name="OrbContent"
              Margin="8"
              RenderTransformOrigin="0.5,0.5">
            <Grid.Effect>
                <DropShadowEffect Color="#4FD8E8"
                                  BlurRadius="28"
                                  ShadowDepth="0"
                                  Opacity="0.48"/>
            </Grid.Effect>
            <Grid.RenderTransform>
                <TransformGroup>
                    <RotateTransform x:Name="OrbNod"/>
                    <TranslateTransform x:Name="OrbTranslation"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <Image Source="/Aurora;component/Assets/AuroraFace.png"
                   Stretch="Uniform"
                   Opacity="0.96"/>
        </Grid>
    </Grid>
</UserControl>

<Window x:Class="ZoeyOS.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aurora Setup" Height="720" Width="560"
        MinHeight="620" MinWidth="520"
        Background="{StaticResource BgDeepBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Activated="Window_Activated">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderText" Text="Welcome to Aurora" FontSize="22" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,0,0,14"
                       Text="Pick an engine and paste your key - no need to touch settings.json by hand."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Chat engine" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <ComboBox x:Name="ProviderCombo" Margin="0,0,0,16" Padding="10,8" FontSize="13"
                          Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                          BorderThickness="0" SelectionChanged="Provider_Changed">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock x:Name="KeyLabel" Text="API key (required)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <PasswordBox x:Name="ApiKeyBox" Grid.Column="0"
                                 Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0" Padding="10" FontSize="13"
                                 LostFocus="ApiKeyBox_LostFocus"/>
                    <Button x:Name="GetKeyButton" Grid.Column="1" Content="Get a key" Margin="8,0,0,0" Padding="12,8"
                            Background="{StaticResource BgPanelBrush}" BorderThickness="0"
                            Foreground="{StaticResource AccentCyanBrush}" Cursor="Hand"
                            Click="GetFreeKey_Click"/>
                </Grid>
                <TextBlock x:Name="KeyHintText" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Model" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,6"/>
                <ComboBox x:Name="ModelBox" Padding="10" FontSize="13"
                          IsEditable="True" IsTextSearchEnabled="True"
                          Background="{StaticResource BgPanelBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                          BorderThickness="0">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock x:Name="ModelExamplesText" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                           TextWrapping="Wrap"/>

                <TextBlock Margin="0,10,0,0" FontSize="11">
                    <Hyperlink x:Name="DocsLink" Click="Link_Click" Foreground="{StaticResource AccentCyanBrush}">API docs</Hyperlink>
                    <Run Foreground="{StaticResource TextMutedBrush}"> · </Run>
                    <Hyperlink x:Name="RateLimitsLink" Click="Link_Click" Foreground="{StaticResource AccentCyanBrush}">Rate limits</Hyperlink>
                    <Run Foreground="{StaticResource TextMutedBrush}"> · </Run>
                    <Hyperlink x:Name="ModelsLink" Click="Link_Click" Foreground="{StaticResource AccentCyanBrush}">Models</Hyperlink>
                    <Run Foreground="{StaticResource TextMutedBrush}"> · </Run>
                    <Hyperlink x:Name="PricingLink" Click="Link_Click" Foreground="{StaticResource AccentCyanBrush}">Pricing</Hyperlink>
                </TextBlock>

                <TextBlock x:Name="ClipboardHint" Margin="0,8,0,0" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentGreenBrush}" Visibility="Collapsed"
                           Text="Pasted from clipboard - double-check it, then hit Save and Continue."/>

                <Border x:Name="ImageGenNote" Background="{StaticResource BgPanelBrush}" CornerRadius="10" Padding="14" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}"
                                   Text="✓ Image generation is included with this same key"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   Text="Gemini's image generation is bundled in - no separate image provider key is required."/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="CostNoteText" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock x:Name="ErrorText" Foreground="#F0745C" Margin="0,14,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="SkipButton" Content="Skip for now" Padding="14,8" Margin="0,0,10,0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{StaticResource TextMutedBrush}" Cursor="Hand"
                        Click="Skip_Click"/>
                <Button x:Name="SaveContinueButton" Content="Save and Continue" Padding="18,8" FontWeight="Bold"
                        Background="{StaticResource AccentCyanBrush}" BorderThickness="0"
                        Foreground="{StaticResource BgDeepBrush}" Cursor="Hand"
                        IsDefault="True" IsEnabled="True"
                        Click="Save_Click"/>
            </StackPanel>
            <TextBlock Grid.Row="1" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                       Text="Your key is stored locally in %AppData%\Aurora\settings.json and sent only to the provider you pick above."/>
        </Grid>
    </Grid>
</Window>

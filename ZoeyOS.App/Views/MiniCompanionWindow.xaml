<Window x:Class="ZoeyOS.App.Views.MiniCompanionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="96" Height="96" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="True">
    <Border CornerRadius="48" Background="#101821" BorderBrush="#4FD8E8" BorderThickness="2" MouseLeftButtonDown="Avatar_MouseLeftButtonDown">
        <Grid>
            <Ellipse Width="28" Height="28" Fill="#4FD8E8" VerticalAlignment="Top" Margin="0,13,0,0"/>
            <Ellipse Width="52" Height="31" Fill="#4FD8E8" VerticalAlignment="Bottom" Margin="0,0,0,13"/>
            <Button Content="×" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Click="Close_Click" Background="#101821" Foreground="White" BorderBrush="#4FD8E8" BorderThickness="1" Padding="0" FontSize="12"/>
        </Grid>
    </Border>
</Window>

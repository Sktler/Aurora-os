<Window x:Class="ZoeyOS.App.Views.JamendoSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jamendo Music" Width="620" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgDeepTranslucentBrush}">
    <Border Background="{StaticResource BgPanelBrush}" CornerRadius="14" Padding="24" Margin="12">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <TextBlock Text="🎵" FontSize="24" Margin="0,0,10,0"/>
                <StackPanel>
                    <TextBlock Text="Jamendo Music" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Music provider settings" Style="{StaticResource MutedText}"/>
                </StackPanel>
            </StackPanel>

            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Connection" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText" Text="Not connected" Margin="10,0,0,0"
                                   Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                    <TextBlock Text="Aurora uses Jamendo's Client ID to search and play music. You do not need to enter the Client Secret here."
                               TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,6,0,14"/>

                    <TextBlock Text="Jamendo Client ID" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ClientIdBox" Grid.Column="0"
                                 Background="{StaticResource BgDeepBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0" Padding="10" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Get Client ID" Margin="10,0,0,0" Padding="14,8"
                                Click="GetClientId_Click"
                                Background="{StaticResource BgDeepBrush}" BorderThickness="0"
                                Foreground="{StaticResource AccentCyanBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{StaticResource BgCardBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Setup" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource MutedText}"
                               Text="1. Click Get Client ID. 2. Create a Jamendo application using the non-commercial plan. 3. Copy the Client ID. 4. Paste it above and save."
                               Margin="0,0,0,10"/>
                    <TextBlock Text="The Client Secret is not stored or required by Aurora." FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Padding="14,8" Margin="0,0,10,0" Click="Close_Click"
                        Background="{StaticResource BgCardBrush}" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"/>
                <Button Content="Save &amp; Connect" Padding="16,8" Click="Save_Click"
                        Background="{StaticResource AccentCyanBrush}" BorderThickness="0"
                        Foreground="{StaticResource BgDeepBrush}" FontWeight="Bold"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" FontSize="11" Foreground="#F0745C" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </Border>
</Window>

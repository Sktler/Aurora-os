<UserControl x:Class="ZoeyOS.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,20"/>

                <!-- Music -->
                <Border Padding="20" CornerRadius="12" Background="#16000000" BorderBrush="#25FFFFFF" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Music" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Jamendo" FontSize="16" FontWeight="Medium" Margin="0,14,0,4"/>
                        <TextBlock Text="Search and play music directly in Aurora using the Jamendo catalog." TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,14"/>

                        <TextBlock Text="Jamendo Client ID" Margin="0,0,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="JamendoClientIdBox" Grid.Column="0" Padding="10"/>
                            <Button Grid.Column="1" Content="Get Client ID" Padding="14,8" Margin="10,0,0,0" Click="GetJamendoClientId_Click"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Save &amp; Connect" Padding="16,9" Click="SaveJamendo_Click"/>
                            <TextBlock x:Name="JamendoStatusText" Text="Not connected" VerticalAlignment="Center" Margin="14,0,0,0" Opacity="0.75"/>
                        </StackPanel>

                        <TextBlock Text="Jamendo is intended for supported non-commercial use. Track licensing and attribution requirements apply." TextWrapping="Wrap" FontSize="12" Opacity="0.6" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

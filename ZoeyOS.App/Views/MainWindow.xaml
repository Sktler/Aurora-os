<Window x:Class="ZoeyOS.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZoeyOS.App.ViewModels"
        xmlns:local="clr-namespace:ZoeyOS.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Aurora" Height="800" Width="1280" MinHeight="600" MinWidth="960"
        Background="{StaticResource BgDeepBrush}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        StateChanged="Window_StateChanged">

    <!-- No native title bar - CaptionHeight=0 hands the whole window to our own dark
         custom title bar below, while still keeping normal edge-resize and Aero snap
         (which a plain WindowStyle="None" window loses on its own). -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                             GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.DataContext>
        <vm:DashboardViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource BgCardBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E0483A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Custom title bar (replaces the native white one) ===== -->
        <Grid Grid.Row="0" Background="{StaticResource BgPanelBrush}"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="AURORA" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="14,0,0,0" VerticalAlignment="Center"
                       shell:WindowChrome.IsHitTestVisibleInChrome="False"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="—" Style="{StaticResource CaptionButtonStyle}"
                        Click="Minimize_Click" ToolTip="Minimize"/>
                <Button x:Name="MaximizeRestoreButton" Content="🗖" Style="{StaticResource CaptionButtonStyle}"
                        Click="MaximizeRestore_Click" ToolTip="Maximize"/>
                <Button Content="✕" Style="{StaticResource CloseButtonStyle}"
                        Click="Close_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>

        <!-- ===== Dashboard content (unchanged) ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Left rail: orb dashboard ===== -->
            <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}" Padding="20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="AURORA" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Button Grid.Column="1" Content="⚙" FontSize="16" Padding="6,2"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{StaticResource TextMutedBrush}" Cursor="Hand"
                                    Click="OpenIntegrations_Click"
                                    ToolTip="Settings"/>
                        </Grid>
                        <TextBlock Text="Your companions" Style="{StaticResource MutedText}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- ===== Now playing (Spotify) - docked to the bottom of the sidebar ===== -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource BgCardBrush}" CornerRadius="12"
                            Padding="14" Margin="0,14,0,0">
                        <StackPanel DataContext="{Binding MusicPlayer}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🎵" FontSize="13" Margin="0,0,6,0"/>
                                <TextBlock Text="Now playing" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding HasTrack, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                <TextBlock Text="{Binding TrackName}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding ArtistName}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Visibility="{Binding HasTrack, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"
                                        Visibility="{Binding IsConnected, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                <Button Content="⏮" FontSize="13" Padding="10,6" Margin="0,0,6,0"
                                        Command="{Binding SkipPreviousCommand}"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource TextPrimaryBrush}" Cursor="Hand" ToolTip="Previous"/>
                                <Button Content="{Binding IsPlaying, Converter={x:Static local:BoolToPlayPauseIconConverter.Instance}}"
                                        FontSize="13" Padding="10,6" Margin="0,0,6,0" Width="34"
                                        Command="{Binding TogglePlayPauseCommand}"
                                        Background="{StaticResource AccentCyanBrush}" BorderThickness="0"
                                        Foreground="{StaticResource BgDeepBrush}" Cursor="Hand" ToolTip="Play / pause"/>
                                <Button Content="⏭" FontSize="13" Padding="10,6"
                                        Command="{Binding SkipNextCommand}"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource TextPrimaryBrush}" Cursor="Hand" ToolTip="Next"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Companions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CompanionViewModel}">
                                <Border Margin="0,0,0,12" Padding="14" CornerRadius="14"
                                        Background="{StaticResource BgCardBrush}"
                                        Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Globe -->
                                        <local:Globe3D Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0"
                                                        AccentColor="{Binding Companion.AccentHex}">
                                            <local:Globe3D.Effect>
                                                <DropShadowEffect Color="{Binding Companion.AccentHex}"
                                                                   BlurRadius="18" ShadowDepth="0" Opacity="0.55"/>
                                            </local:Globe3D.Effect>
                                        </local:Globe3D>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Companion.Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Companion.Role}" Style="{StaticResource MutedText}"/>
                                            <TextBlock Text="{Binding Companion.LastActivitySummary}"
                                                       Style="{StaticResource MutedText}"
                                                       TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>

            <!-- ===== Right side: active companion chat panel ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Padding="24,20" Background="{StaticResource BgPanelBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <local:Globe3D Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center"
                                            AccentColor="{Binding SelectedCompanion.Companion.AccentHex}"/>
                            <StackPanel>
                                <!-- Display mode: name + rename (pencil) button -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding SelectedCompanion.IsRenaming, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}">
                                    <TextBlock Text="{Binding SelectedCompanion.Companion.Name}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <Button Content="✎" Margin="8,0,0,0" Padding="6,2" FontSize="12"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource TextMutedBrush}" Cursor="Hand"
                                            Command="{Binding SelectedCompanion.BeginRenameCommand}"
                                            ToolTip="Rename this companion"/>
                                </StackPanel>

                                <!-- Edit mode: textbox + confirm/cancel -->
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding SelectedCompanion.IsRenaming, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                    <TextBox Text="{Binding SelectedCompanion.RenameDraft, UpdateSourceTrigger=PropertyChanged}"
                                             Width="160" FontSize="16" Padding="6,3"
                                             Background="{StaticResource BgCardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderThickness="0" VerticalContentAlignment="Center">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding SelectedCompanion.CommitRenameCommand}"/>
                                            <KeyBinding Key="Escape" Command="{Binding SelectedCompanion.CancelRenameCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Content="✓" Margin="6,0,0,0" Padding="8,3" FontWeight="Bold"
                                            Background="{StaticResource AccentGreenBrush}" BorderThickness="0"
                                            Foreground="{StaticResource BgDeepBrush}" Cursor="Hand"
                                            Command="{Binding SelectedCompanion.CommitRenameCommand}"/>
                                    <Button Content="✕" Margin="4,0,0,0" Padding="8,3"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{StaticResource TextMutedBrush}" Cursor="Hand"
                                            Command="{Binding SelectedCompanion.CancelRenameCommand}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding SelectedCompanion.Companion.Role}" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Flip between text chat and the big orb view -->
                        <Button Grid.Column="1" Padding="12,8"
                                Command="{Binding SelectedCompanion.ToggleOrbViewCommand}"
                                Background="{StaticResource BgCardBrush}" BorderThickness="0" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Content" Value="🔮 Orb view"/>
                                    <Setter Property="ToolTip" Value="Switch to the big orb view"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCompanion.IsOrbViewActive}" Value="True">
                                            <Setter Property="Content" Value="💬 Text chat"/>
                                            <Setter Property="ToolTip" Value="Switch back to the text chat"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Message list / orb view - same cell, one visible at a time -->
                <Grid Grid.Row="1">
                    <ScrollViewer Padding="24,16" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding SelectedCompanion.IsOrbViewActive, Converter={x:Static local:BoolToVisibilityConverter.Instance}, ConverterParameter=Invert}">
                        <ItemsControl ItemsSource="{Binding SelectedCompanion.Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,14"
                                            HorizontalAlignment="{Binding Role, Converter={x:Static local:RoleToAlignmentConverter.Instance}}"
                                            MaxWidth="640" Padding="14,10" CornerRadius="12"
                                            Background="{Binding Role, Converter={x:Static local:RoleToBrushConverter.Instance}}">
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                   Foreground="{Binding Role, Converter={x:Static local:RoleToTextBrushConverter.Instance}}"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Visibility="{Binding SelectedCompanion.IsOrbViewActive, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                        <local:ParticleOrb Width="360" Height="360" Margin="40"/>
                    </Grid>
                </Grid>

                <!-- Composer -->
                <Border Grid.Row="2" Padding="24,18" Background="{StaticResource BgPanelBrush}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Speak-replies toggle -->
                            <Button Grid.Column="0" Margin="0,0,10,0" Padding="10,10"
                                    Command="{Binding SelectedCompanion.ToggleSpeakRepliesCommand}"
                                    BorderThickness="0" Cursor="Hand"
                                    ToolTip="Read this companion's replies out loud">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                                        <Setter Property="Content" Value="🔇"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCompanion.SpeakRepliesEnabled}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                                                <Setter Property="Content" Value="🔊"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Attach a file -->
                            <Button Grid.Column="1" Content="📎" Margin="0,0,10,0" Padding="10,10"
                                    Click="Attach_Click"
                                    Background="{StaticResource BgCardBrush}" BorderThickness="0" Cursor="Hand"
                                    ToolTip="Attach a text file to this message"/>

                            <TextBox Grid.Column="2" Text="{Binding SelectedCompanion.DraftMessage, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource BgCardBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderThickness="0" Padding="12" FontSize="14"
                                     AcceptsReturn="False" VerticalContentAlignment="Center">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Return" Command="{Binding SelectedCompanion.SendCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <!-- Mic / voice input -->
                            <Button Grid.Column="3" Margin="10,0,0,0" Padding="14,10"
                                    Command="{Binding SelectedCompanion.ListenCommand}"
                                    BorderThickness="0" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
                                        <Setter Property="Content" Value="🎤"/>
                                        <Setter Property="ToolTip" Value="Turn on hands-free listening - stays on and sends each thing you say until you tap it again"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCompanion.IsListening}" Value="True">
                                                <Setter Property="Background" Value="#F0745C"/>
                                                <Setter Property="Content" Value="● Listening…"/>
                                                <Setter Property="ToolTip" Value="Listening continuously - tap to turn off"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Grid.Column="4" Content="Send" Margin="10,0,0,0" Padding="18,10"
                                    Command="{Binding SelectedCompanion.SendCommand}"
                                    Background="{StaticResource AccentCyanBrush}" BorderThickness="0"
                                    Foreground="{StaticResource BgDeepBrush}" FontWeight="Bold"/>
                        </Grid>

                        <TextBlock Text="{Binding SelectedCompanion.AttachStatus}" Style="{StaticResource MutedText}"
                                   Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

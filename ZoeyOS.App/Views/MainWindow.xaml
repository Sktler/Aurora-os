<Window x:Class="ZoeyOS.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZoeyOS.App.ViewModels"
        xmlns:local="clr-namespace:ZoeyOS.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Aurora" Height="800" Width="1280" MinHeight="600" MinWidth="960" Background="{StaticResource BgDeepBrush}" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
    <Window.DataContext><vm:DashboardViewModel/></Window.DataContext>
    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="34"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}"/>
        <Style x:Key="MiniButtonStyle" TargetType="Button"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="34"/><Setter Property="Background" Value="#16242D"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="15"/><Setter Property="Cursor" Value="Hand"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style>
        <Style x:Key="ComposerButtonStyle" TargetType="Button"><Setter Property="Width" Value="42"/><Setter Property="Height" Value="42"/><Setter Property="Margin" Value="6,0,0,0"/><Setter Property="Background" Value="{StaticResource BgCardBrush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="16"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{StaticResource BgPanelBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="AURORA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="14,0,0,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="False"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="◉" Style="{StaticResource MiniButtonStyle}" Click="MiniMode_Click" ToolTip="Mini Aurora"/><Button Content="—" Style="{StaticResource CaptionButtonStyle}" Click="Minimize_Click" ToolTip="Minimize"/><Button x:Name="MaximizeRestoreButton" Content="🗖" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeRestore_Click" ToolTip="Maximize"/><Button Content="✕" Style="{StaticResource CloseButtonStyle}" Click="Close_Click" ToolTip="Close"/></StackPanel></Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}" Padding="20"><DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="AURORA" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/><Button Grid.Column="1" Content="⚙" FontSize="16" Padding="6,2" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" Cursor="Hand" Click="OpenIntegrations_Click" ToolTip="Settings"/></Grid><TextBlock Text="Your companions" Style="{StaticResource MutedText}" Margin="0,2,0,0"/></StackPanel>
                <Border DockPanel.Dock="Bottom" Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="14" Margin="0,14,0,0"><StackPanel DataContext="{Binding MusicPlayer}"><StackPanel Orientation="Horizontal"><TextBlock Text="🎵" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Now playing" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Companions}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:CompanionViewModel}"><Button Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Stretch" Margin="0,0,0,12"><Border Padding="14" CornerRadius="14" Background="{StaticResource BgCardBrush}" Cursor="Hand"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:Globe3D Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" AccentColor="{Binding Companion.AccentHex}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Companion.Name}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Companion.Role}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Companion.LastActivitySummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"/></StackPanel></Grid></Border></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            </DockPanel></Border>
            <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="24,20" Background="{StaticResource BgPanelBrush}"><StackPanel Orientation="Horizontal"><local:Globe3D Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" AccentColor="{Binding SelectedCompanion.Companion.AccentHex}"/><StackPanel><TextBlock Text="{Binding SelectedCompanion.Companion.Name}" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding SelectedCompanion.Companion.Role}" Style="{StaticResource MutedText}"/></StackPanel></StackPanel></Border>
                <Grid Grid.Row="1"><ScrollViewer Padding="24,16" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding SelectedCompanion.Messages}"><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,0,14" MaxWidth="640" Padding="14,10" CornerRadius="12" Background="{Binding Role, Converter={x:Static local:RoleToBrushConverter.Instance}}"><TextBlock Text="{Binding Content}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
                <Border Grid.Row="2" Padding="18,14" Background="{StaticResource BgPanelBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Grid.Column="0" Text="{Binding SelectedCompanion.DraftMessage, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MaxHeight="110" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" FontSize="14" Background="{StaticResource BgCardBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="1"/><Button Grid.Column="1" Content="📎" Style="{StaticResource ComposerButtonStyle}" Click="Attach_Click" ToolTip="Attach a file"/><Button Grid.Column="2" Content="🎤" Style="{StaticResource ComposerButtonStyle}" Command="{Binding SelectedCompanion.ListenCommand}" ToolTip="Start or stop dictation"/><Button Grid.Column="3" Content="🔊" Style="{StaticResource ComposerButtonStyle}" Command="{Binding SelectedCompanion.ToggleSpeakRepliesCommand}" ToolTip="Toggle spoken replies"/><Button Grid.Column="4" Content="➤" Style="{StaticResource ComposerButtonStyle}" Command="{Binding SelectedCompanion.SendCommand}" ToolTip="Send" IsDefault="True"/></Grid></Border>
            </Grid>
        </Grid>
    </Grid>
</Window>

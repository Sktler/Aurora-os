<Window x:Class="ZoeyOS.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZoeyOS.App.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Aurora" Height="900" Width="1440" MinHeight="700" MinWidth="1100"
        Background="{StaticResource BgDeepBrush}" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.DataContext><vm:DashboardViewModel/></Window.DataContext>
    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="34"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        </Style>
        <Style x:Key="MiniButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
            <Setter Property="Background" Value="#101722"/><Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/><Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#24142F"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/></Trigger></Style.Triggers>
        </Style>
        <ContextMenu x:Key="ComposerMenu" x:Name="ComposerMenu">
            <MenuItem Header="📎  Add file" Click="Attach_Click"/>
            <MenuItem Header="📷  Take photo" Click="TakePhoto_Click"/>
            <MenuItem x:Name="RecordVideoButton" Header="🎥  Record video" Click="RecordVideo_Click"/>
            <Separator/>
            <MenuItem Header="🎙  Voice input" Command="{Binding SelectedCompanion.ListenCommand}"/>
            <MenuItem Header="♫  Music" Click="ComposerMusic_Click"/>
            <MenuItem Header="⌂  Smart Home" Click="SmartHome_Click"/>
            <MenuItem Header="☑  Add reminder" Click="AddReminder_Click"/>
            <Separator/>
            <MenuItem Header="⚙  Settings" Click="ComposerSettings_Click"/>
        </ContextMenu>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="#090C12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Aurora" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="16,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="False"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ToggleLeftSidebarButton" Content="☰" Style="{StaticResource CaptionButtonStyle}" Click="ToggleLeftSidebar_Click" ToolTip="Hide navigation"/>
                <Button x:Name="ToggleRightSidebarButton" Content="◫" Style="{StaticResource CaptionButtonStyle}" Click="ToggleRightSidebar_Click" ToolTip="Hide information panel"/>
                <Button Content="◉" Style="{StaticResource MiniButtonStyle}" Click="MiniMode_Click" ToolTip="Mini Aurora"/>
                <Button Content="—" Style="{StaticResource CaptionButtonStyle}" Click="Minimize_Click" ToolTip="Minimize"/>
                <Button x:Name="MaximizeRestoreButton" Content="🗖" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeRestore_Click" ToolTip="Maximize"/>
                <Button Content="✕" Style="{StaticResource CaptionButtonStyle}" Click="Close_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftSidebarColumn" Width="230"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="RightSidebarColumn" Width="350"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0D111A" BorderBrush="#1B2230" BorderThickness="0,0,1,0" Padding="14">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="#111722" CornerRadius="14" Padding="12" Margin="0,14,0,0">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="19" BorderBrush="{StaticResource AccentVioletBrush}" BorderThickness="2"><TextBlock Text="A" Foreground="{StaticResource AccentCyanBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Adam" FontWeight="SemiBold"/><TextBlock Text="Premium Plan" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel>
                            <Button Grid.Column="2" Content="⌄" Width="28" Height="32" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" FontSize="18" Click="ProfileMenu_Click" ToolTip="Account menu"/>
                        </Grid>
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="6,12,0,26"><Border Width="48" Height="48" CornerRadius="24" BorderBrush="{StaticResource AccentCyanBrush}" BorderThickness="2" Background="#101722"><TextBlock Text="✦" FontSize="25" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Aurora" FontSize="23" FontWeight="Bold" Foreground="{StaticResource AccentVioletBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel>
                        <Button Tag="home" Style="{StaticResource NavButtonStyle}" Background="#251431" Click="Navigation_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" Width="32" FontSize="20" Foreground="{StaticResource AccentVioletBrush}"/><TextBlock Text="Home" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Tag="chat" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="32" FontSize="17"/><TextBlock Text="Chat" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Tag="memory" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" Width="32" FontSize="19"/><TextBlock Text="Memory" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Tag="music" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="♫" Width="32" FontSize="20"/><TextBlock Text="Music" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Tag="smarthome" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" Width="32" FontSize="20"/><TextBlock Text="Smart Home" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Tag="tools" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⚒" Width="32" FontSize="18"/><TextBlock Text="Tools" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button Tag="camera" Style="{StaticResource NavButtonStyle}" Click="Navigation_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Width="32" FontSize="18" Foreground="{StaticResource AccentCyanBrush}"/><TextBlock Text="Camera" VerticalAlignment="Center"/></StackPanel></Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Background="#080B11">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,22,0,0"><TextBlock Text="Aurora" FontSize="48" FontWeight="Light" HorizontalAlignment="Center" Foreground="{StaticResource AccentCyanBrush}"><TextBlock.Effect><DropShadowEffect Color="#4FD8E8" BlurRadius="22" ShadowDepth="0" Opacity="0.45"/></TextBlock.Effect></TextBlock><TextBlock Text="Your AI Companion" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"/></StackPanel>
                <Grid Grid.Row="1">
                    <Image Source="/ZoeyOS.App;component/Assets/AuroraOrb.png" Width="430" Height="430" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,8,0,0"/>
                </Grid>
                <Border Grid.Row="2" Margin="34,0,34,16" Background="#0E131D" BorderBrush="#293245" BorderThickness="1" CornerRadius="24" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Width="38" Height="38" Background="#171D29" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" Content="♩" FontSize="19" Command="{Binding SelectedCompanion.ListenCommand}" ToolTip="Voice input"/>
                        <Button Grid.Column="1" Width="40" Height="40" Margin="4,0" Background="#101620" Foreground="{StaticResource AccentCyanBrush}" BorderBrush="#2C3446" BorderThickness="1" Content="＋" FontSize="20" Click="OpenComposerMenu_Click" ToolTip="Add files, tools, and actions"/>
                        <TextBox x:Name="ComposerTextBox" Grid.Column="2" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" VerticalContentAlignment="Center" FontSize="14" Padding="12,0" ToolTip="Ask Aurora anything"/>
                        <Button Grid.Column="3" Width="40" Height="40" Background="#4B16A0" Foreground="White" BorderThickness="0" Content="➤" FontSize="17" Click="Send_Click" ToolTip="Send"/>
                        <Button Grid.Column="4" Width="40" Height="40" Background="#101620" Foreground="{StaticResource AccentCyanBrush}" BorderBrush="#2C3446" BorderThickness="1" Content="⌕" FontSize="18" Click="Attach_Click" ToolTip="Attach file"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="#0D111A" BorderBrush="#1B2230" BorderThickness="1,0,0,0" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <Border Background="#101620" BorderBrush="#202A3A" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,26,0,10"><StackPanel><TextBlock Text="Aurora Status" FontSize="17" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Ellipse Width="10" Height="10" Fill="{StaticResource AccentGreenBrush}"/><TextBlock Text="Online" Foreground="{StaticResource AccentGreenBrush}" Margin="8,0,0,0" FontSize="14"/></StackPanel><TextBlock Text="{Binding WakeWordStatus}" Style="{StaticResource MutedText}" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                    <Border Background="#101620" BorderBrush="#202A3A" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,10"><StackPanel><TextBlock Text="Today's Overview" FontSize="17" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,18,0,0"><TextBlock Text="☼" FontSize="28" Foreground="{StaticResource AccentAmberBrush}"/><StackPanel Margin="12,0,0,0"><TextBlock Text="{Binding WeatherTemperature}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding WeatherCondition}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding WeatherLocation}" Style="{StaticResource MutedText}" FontSize="11"/></StackPanel></StackPanel><TextBlock Text="{Binding WeatherSummary}" Margin="0,10,0,0" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"/><Button Content="Open today's schedule" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentCyanBrush}" Click="OpenTodayOverview_Click"/></StackPanel></Border>
                    <Border Background="#101620" BorderBrush="#202A3A" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,10"><StackPanel DataContext="{Binding MusicPlayer}"><StackPanel Orientation="Horizontal"><TextBlock Text="♫" FontSize="25" Foreground="{StaticResource AccentVioletBrush}"/><TextBlock Text="Now Playing" FontSize="17" FontWeight="SemiBold" Margin="12,2,0,0"/></StackPanel><TextBlock Text="{Binding StatusText}" FontSize="14" Margin="0,16,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding TrackName}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock Text="{Binding ArtistName}" Style="{StaticResource MutedText}" Margin="0,2,0,0" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0"><Button Content="◀◀" Command="{Binding SkipPreviousCommand}" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" FontSize="16" Padding="8" ToolTip="Previous"/><Button Content="▶" Command="{Binding TogglePlayPauseCommand}" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" FontSize="18" Padding="12" ToolTip="Play / pause"/><Button Content="▶▶" Command="{Binding SkipNextCommand}" Background="Transparent" Foreground="{StaticResource TextPrimaryBrush}" BorderThickness="0" FontSize="16" Padding="8" ToolTip="Next"/></StackPanel></StackPanel></Border>
                    <Border Background="#101620" BorderBrush="#202A3A" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,10"><StackPanel><TextBlock Text="System" FontSize="17" FontWeight="SemiBold"/><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12"><Ellipse Width="58" Height="58" Stroke="{StaticResource AccentVioletBrush}" StrokeThickness="5"/><TextBlock Text="{Binding CpuUsage}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,-40,0,0"/><TextBlock Text="CPU" HorizontalAlignment="Center" Margin="0,20,0,0" Style="{StaticResource MutedText}"/></StackPanel><StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12"><Ellipse Width="58" Height="58" Stroke="{StaticResource AccentVioletBrush}" StrokeThickness="5"/><TextBlock Text="{Binding RamUsage}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,-40,0,0"/><TextBlock Text="RAM" HorizontalAlignment="Center" Margin="0,20,0,0" Style="{StaticResource MutedText}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0"><Ellipse Width="58" Height="58" Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="5"/><TextBlock Text="{Binding DiskUsage}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,-40,0,0"/><TextBlock Text="Disk" HorizontalAlignment="Center" Margin="0,20,0,0" Style="{StaticResource MutedText}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0"><Ellipse Width="58" Height="58" Stroke="{StaticResource AccentCyanBrush}" StrokeThickness="5"/><TextBlock Text="{Binding GpuUsage}" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,-40,0,0"/><TextBlock Text="GPU" HorizontalAlignment="Center" Margin="0,20,0,0" Style="{StaticResource MutedText}"/></StackPanel></Grid><TextBlock Text="Live Windows performance" Style="{StaticResource MutedText}" FontSize="10" Margin="0,12,0,0"/></StackPanel></Border>
                    <TextBlock Text="{Binding SelectedCompanion.Companion.Name}" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="4,4,0,0"/><TextBlock Text="{Binding SelectedCompanion.Companion.Role}" Style="{StaticResource MutedText}" Margin="4,2,0,0"/>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>

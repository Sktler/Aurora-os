<Window x:Class="ZoeyOS.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ZoeyOS.App.ViewModels"
        xmlns:local="clr-namespace:ZoeyOS.App.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Aurora" Height="800" Width="1280" MinHeight="600" MinWidth="960"
        Background="{StaticResource BgDeepBrush}" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize" StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.DataContext><vm:DashboardViewModel/></Window.DataContext>
    <Window.Resources>
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/><Setter Property="Height" Value="34"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="Cursor" Value="Hand"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{StaticResource BgCardBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#E0483A"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="MiniButtonStyle" TargetType="Button"><Setter Property="Background" Value="#16242D"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#203640"/></Trigger></Style.Triggers></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{StaticResource BgPanelBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="AURORA" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="14,0,0,0" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="False"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="◉" Style="{StaticResource MiniButtonStyle}" Click="MiniMode_Click" ToolTip="Mini Aurora"/>
                <Button Content="—" Style="{StaticResource CaptionButtonStyle}" Click="Minimize_Click" ToolTip="Minimize"/>
                <Button x:Name="MaximizeRestoreButton" Content="🗖" Style="{StaticResource CaptionButtonStyle}" Click="MaximizeRestore_Click" ToolTip="Maximize"/>
                <Button Content="✕" Style="{StaticResource CloseButtonStyle}" Click="Close_Click" ToolTip="Close"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}" Padding="20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="AURORA" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/><Button Grid.Column="1" Content="⚙" FontSize="16" Padding="6,2" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" Cursor="Hand" Click="OpenIntegrations_Click" ToolTip="Settings"/></Grid><TextBlock Text="Your companions" Style="{StaticResource MutedText}" Margin="0,2,0,0"/></StackPanel>
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource BgCardBrush}" CornerRadius="12" Padding="14" Margin="0,14,0,0"><StackPanel DataContext="{Binding MusicPlayer}"><StackPanel Orientation="Horizontal"><TextBlock Text="🎵" FontSize="13" Margin="0,0,6,0"/><TextBlock Text="Now playing" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/></StackPanel><TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"/></StackPanel></Border>
                    <ItemsControl ItemsSource="{Binding Companions}"><ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:CompanionViewModel}"><Border Margin="0,0,0,12" Padding="14" CornerRadius="14" Background="{StaticResource BgCardBrush}" Cursor="Hand"><Border.InputBindings><MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/></Border.InputBindings><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:Globe3D Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" AccentColor="{Binding Companion.AccentHex}"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Companion.Name}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Companion.Role}" Style="{StaticResource MutedText}"/><TextBlock Text="{Binding Companion.LastActivitySummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="0" Padding="24,20" Background="{StaticResource BgPanelBrush}"><Grid><StackPanel Orientation="Horizontal"><local:Globe3D Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" AccentColor="{Binding SelectedCompanion.Companion.AccentHex}"/><StackPanel><TextBlock Text="{Binding SelectedCompanion.Companion.Name}" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding SelectedCompanion.Companion.Role}" Style="{StaticResource MutedText}"/></StackPanel></StackPanel></Grid></Border><Grid Grid.Row="1"><ScrollViewer Padding="24,16" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding SelectedCompanion.Messages}"><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,0,14" MaxWidth="640" Padding="14,10" CornerRadius="12" Background="{Binding Role, Converter={x:Static local:RoleToBrushConverter.Instance}}"><TextBlock Text="{Binding Content}" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid><Border Grid.Row="2" Padding="24,18" Background="{StaticResource BgPanelBrush}"/></Grid>
        </Grid>
    </Grid>
</Window>
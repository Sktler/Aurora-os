<UserControl x:Class="ZoeyOS.App.Views.Globe3D"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ClipToBounds="False">
    <Viewport3D x:Name="Viewport">
        <Viewport3D.Camera>
            <PerspectiveCamera x:Name="Camera" Position="0,0,3.1" LookDirection="0,0,-1"
                                UpDirection="0,1,0" FieldOfView="38"/>
        </Viewport3D.Camera>

        <!-- Lighting: ambient keeps the dark side visible, one directional light gives the
             sphere an actual lit/shadowed hemisphere so it reads as three-dimensional
             instead of a flat tinted circle. -->
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <Model3DGroup>
                    <AmbientLight Color="#3A3A3A"/>
                    <DirectionalLight Color="#FFFFFF" Direction="-0.5,-0.35,-1"/>
                </Model3DGroup>
            </ModelVisual3D.Content>
        </ModelVisual3D>

        <!-- The sphere mesh, material, and spin animation are built in code-behind
             (Globe3D.xaml.cs) since WPF has no built-in sphere primitive to declare in XAML. -->
        <ModelVisual3D x:Name="SphereVisual"/>
    </Viewport3D>
</UserControl>
